<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Product>AdventOfCode</Product>
    <Authors>Rory Claasen</Authors>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/roryclaasen/advent</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;osx-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>

    <Features>$(Features);runtime-async=on</Features>

    <IsAotCompatible Condition="'$(IsAotCompatible)'==''">true</IsAotCompatible>

    <DebugType>embedded</DebugType>

    <IsPublishable>false</IsPublishable>
    <IsPackable>false</IsPackable>

    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Label="Code Quality">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup Label="Code Quality">
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Formatting.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
